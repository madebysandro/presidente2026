{
	"name": "presidente2026",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"description": "Pesquisas e apuração do 2º turno 2026 (Presidente nacional) em presidente2026.win.",
	"homepage": "https://presidente2026.win",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/madebysandro/presidente2026.git"
	},
	"bugs": {
		"url": "https://github.com/madebysandro/presidente2026/issues"
	},
	"engines": {
		"node": ">=24.21.0"
	},
	"scripts": {
		"postinstall": "node scripts/patch-vpw-self-scheduled.mjs",
		"prepare:void": "void prepare",
		"dev": "vite",
		"build": "void prepare && tsc --noEmit && vite build",
		"test": "node --test scripts/alerta-workers-builds.test.mjs && void prepare && vite build && node --test scripts/pre-deploy.test.mjs && node scripts/preparar-teste-void.mjs && vitest run && node --test scripts/modo-deploy.test.mjs",
		"test:watch": "void prepare && vite build && node scripts/preparar-teste-void.mjs && vitest",
		"smoke": "node scripts/smoke-vinheta.mjs",
		"ensaio": "npm run build && node scripts/ensaio-noite.mjs",
		"sonda:agente": "npm run build && node scripts/sondar-agente.mjs",
		"deploy": "void deploy --platform cloudflare",
		"og:preparar": "node scripts/preparar-og.mjs"
	},
	"overrides": {
		"undici": "7.30.0",
		"sharp": "0.35.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.23.0",
		"@msw/cloudflare": "^0.2.0",
		"@types/node": "^26.6.5",
		"miniflare": "5.20261012.0-beta",
		"msw": "^3.0.3",
		"playwright-core": "^1.64.1",
		"@shuding/opentype.js": "^1.4.0-beta.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^4.1.12",
		"void": "^1.1.11"
	},
	"dependencies": {
		"jpeg-js": "^0.4.4"
	}
}
