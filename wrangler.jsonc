{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "presidente2026",
	"main": "src/index.ts",
	// Teto do workerd embutido em @cloudflare/vitest-pool-workers@0.22 (testes locais).
	"compatibility_date": "2026-08-22",
	// Sem workers.dev: a API do agente não deve ter segundo endereço público (spec D0).
	"workers_dev": false,
	"routes": [
		{
			"pattern": "presidente2026.win",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "POLLER",
				"class_name": "PollerApuracao"
			},
			{
				"name": "PESQUISAS",
				"class_name": "Pesquisas"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PollerApuracao"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["Pesquisas"]
		}
	],
	"vars": {
		"TSE_BASE": "https://resultados.tse.jus.br/oficial",
		"ELEICAO_FEDERAL": "6258"
	},
	// Habilita Workers Caching para honrar Cache-Control/s-maxage de /api/apuracao.
	"cache": {
		"enabled": true
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	}
}
